---
import Header from "@components/shared/Header.astro";
import AsideThemeSlider from "@components/shared/AsideThemeSlider.astro";
import NewsletterCard from "@components/shared/NewsletterCard.astro";
import Footer from "@components/shared/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  hideNewsletter?: boolean;
}

const {
  title = "Suman Ezhumalai — Blog",
  description = "Personal blog of Suman Ezhumalai — Full Stack & Backend Developer writing about Java, Spring Boot, REST APIs, PostgreSQL, Linux systems, and web performance.",
  activePath = "/",
  hideNewsletter = false,
} = Astro.props;
---

<!doctype html>
<!--
  keyboard shortcuts:
  b  black (theme--00)
  w  white (theme--16)
  s  sunlight (cycle spectrum)
-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://sumanezhumalai.com${Astro.url.pathname}`} />

    <meta name="description" content={description} />
    <meta name="keywords" content="Suman Ezhumalai, Blog, Backend Developer, Linux, VPS, Security, Full Stack, Java, Spring Boot, Docker, Infrastructure" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Suman Ezhumalai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://sumanezhumalai.com/assets/app/meta.webp" />
    <meta property="og:url" content={`https://sumanezhumalai.com${Astro.url.pathname}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sumanezhumalai.com/assets/app/meta.webp" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PF34ZXRDQV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-PF34ZXRDQV');
    </script>
  </head>

  <body class="theme--16">
    <!-- Immediate theme restoration before first paint -->
    <script is:inline>
      (function() {
        var theme = null;
        try {
          theme = localStorage.getItem('suman-theme');
        } catch (e) {}
        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          theme = 'theme--00';
        }
        if (theme) {
          document.body.className = theme;
          var match = theme.match(/theme--(\d+)/);
          if (match) {
            document.documentElement.style.setProperty('--theme-val', match[1]);
          }
        }
      })();
    </script>
    <div class="blog-page-container">
      <Header activePath={activePath} />

      <main class="blog-main-content">
        <div class="blog-content-area">
          <slot />
        </div>
        <div class="blog-bottom-section">
          {!hideNewsletter && <NewsletterCard />}
          <Footer />
        </div>
      </main>
    </div>

    <AsideThemeSlider />

    <script src="/scripts/script.js" is:inline></script>
  </body>
</html>

<style is:global>
  body {
    overflow-x: hidden;
  }

  .blog-page-container {
    max-width: 48rem; /* 768px - exact match of max-w-3xl in flavien-bonvin */
    margin: 0 auto;
    padding: 0 1.25rem;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    .blog-page-container {
      padding: 0;
    }
  }

  .blog-main-content {
    flex: 1 1 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .blog-content-area {
    flex: 1 0 auto;
    width: 100%;
  }

  .blog-bottom-section {
    margin-top: auto;
    width: 100%;
  }
</style>
