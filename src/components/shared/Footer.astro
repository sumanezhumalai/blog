---
// Minimalist Footer
---

<footer class="blog-footer flex h-14 items-center justify-between font-mono text-xs">
  <a
    href="mailto:sumanezhumalai@gmail.com"
    class="footer-email lowercase tracking-normal"
  >
    sumanezhumalai@gmail.com
  </a>

  <div class="footer-links flex items-center gap-6">
    <a
      href="https://github.com/sumanezhumalai"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link uppercase tracking-widest"
    >
      GitHub
    </a>
    <a
      href="https://linkedin.com/in/sumanezhumalai"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link uppercase tracking-widest"
    >
      LinkedIn
    </a>
  </div>
</footer>

<style>
  .blog-footer {
    border-top: 1px solid var(--color--foreground--15);
    margin-bottom: 2rem;
    width: 100%;
  }

  .footer-email {
    color: var(--color--foreground--50);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
    text-underline-offset: 4px;
    letter-spacing: 0.02em;
  }

  .footer-email:hover {
    color: var(--color--foreground--100);
    text-decoration: underline;
    text-decoration-color: var(--color--foreground--33);
  }

  .footer-link {
    color: var(--color--foreground--50);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color--foreground--100);
  }
</style>
