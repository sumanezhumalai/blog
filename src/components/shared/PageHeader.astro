---
interface Props {
  title?: string;
}

const { title = "Blog" } = Astro.props;
---

<header class="page-header mb-12 sm:mb-14">
  <h1 class="page-title font-medium tracking-tighter">
    {title}
  </h1>
  {
    Astro.slots.has("default") && (
      <p class="page-subtitle mt-3 text-sm italic">
        <slot />
      </p>
    )
  }
</header>

<style>
  .page-header {
    margin-top: 0.5rem;
  }
  .page-title {
    color: var(--color--foreground--100);
    font-size: clamp(3rem, 7.5vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.0;
  }
  .page-subtitle {
    color: var(--color--foreground--50);
  }
</style>
