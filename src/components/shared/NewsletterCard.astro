---
// Newsletter Card replicating flavien-bonvin's design
---

<div class="newsletter-card flex flex-col">
  <h2 class="newsletter-title tracking-tight">
    Subscribe to the newsletter
  </h2>
  <p class="newsletter-desc italic">
    One article at a time. No campaigns, no filler.
  </p>
  <a
    href="mailto:sumanezhumalai@gmail.com?subject=Subscribe%20to%20Newsletter"
    class="newsletter-btn inline-block w-fit font-mono uppercase transition-colors"
  >
    Subscribe
  </a>
</div>

<style>
  .newsletter-card {
    border-top: 1px solid var(--color--foreground--15);
    padding-top: 2.5rem;
    padding-bottom: 2.25rem;
    width: 100%;
  }

  .newsletter-title {
    color: var(--color--foreground--100);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .newsletter-desc {
    color: var(--color--foreground--50);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .newsletter-btn {
    border: 1px solid var(--color--foreground--20);
    color: var(--color--foreground--100);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    padding: 0.5rem 1rem;
    line-height: 1;
    border-radius: 4px;
  }

  .newsletter-btn:hover {
    border-color: var(--color--foreground--50);
    background-color: var(--color--foreground--5);
  }
</style>
