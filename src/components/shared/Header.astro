---
interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;
const brandLetters = "Suman Ezhumalai".split("").map((char, idx) => ({
  char,
  isSpace: char === " ",
  i: idx > 0 ? idx - 1 : undefined,
  rev: idx > 0 ? 14 - idx : undefined,
}));
---

<header class="blog-header">
  <div class="header-content">
    <div class="brand" aria-label="Suman Ezhumalai">
      <h3 class="brand-title">
        {
          brandLetters.map((item) =>
            item.isSpace ? (
              <span class="brand-space" style={`--i: ${item.i}; --rev: ${item.rev};`}>&nbsp;</span>
            ) : item.i !== undefined ? (
              <span style={`--i: ${item.i}; --rev: ${item.rev};`}>{item.char}</span>
            ) : (
              <span>{item.char}</span>
            )
          )
        }
      </h3>
    </div>

    <nav class="actions" aria-label="Main Navigation">
      <a
        href="/"
        class:list={["header-link", (activePath === "/" || activePath === "/articles") && "is--active"]}
      >
        Blog
      </a>
      <a
        href="https://sumanezhumalai.com"
        target="_blank"
        rel="noopener noreferrer"
        class="header-link"
      >
        About
      </a>
    </nav>
  </div>
</header>

<style>
  .blog-header {
    width: 100%;
    border-bottom: 1px solid var(--color--foreground--15);
    margin-bottom: 2.5rem;
    position: relative;
  }

  .header-content {
    height: 3.5rem; /* 56px - exact height from flavien-bonvin */
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .brand {
    cursor: default;
    user-select: none;
    display: inline-block;
  }

  .brand-title {
    margin-left: var(--font--margin-left, -0.07em);
    font-size: 1.0625rem; /* Optimal, refined fit alongside navigation */
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .brand-title span:nth-child(n+2) {
    margin-left: -0.035em;
    opacity: 0;
    display: inline-block;
    transition: margin-left 0.3s ease-in, opacity 0.3s ease-in;
    transition-delay: calc(var(--rev, 0) * 0.01s);
  }

  .brand-title .brand-space {
    width: 0;
    overflow: hidden;
    margin-left: 0;
    transition: width 0.3s ease-in, opacity 0.3s ease-in;
    transition-delay: calc(var(--rev, 0) * 0.01s);
  }

  .brand:hover .brand-title span:nth-child(n+2) {
    margin-left: 0;
    opacity: 1;
    transition: margin-left 0.3s ease-out, opacity 0.3s ease-out;
    transition-delay: calc(var(--i, 0) * 0.01s);
  }

  .brand:hover .brand-title .brand-space {
    width: 0.35em;
    margin-left: 0;
    opacity: 1;
    transition: width 0.3s ease-out, opacity 0.3s ease-out;
    transition-delay: calc(var(--i, 0) * 0.01s);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-link {
    font-family: var(--font--mono);
    font-size: 0.8125rem;
    color: var(--color--foreground--50);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .header-link:hover,
  .header-link.is--active {
    color: var(--color--foreground--100);
  }
</style>
