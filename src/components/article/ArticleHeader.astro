---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
---

<header class="mb-10">
  <div class="article-meta mb-2 flex items-center gap-3 font-mono text-xs tracking-wider uppercase">
    <time datetime={article.data.publicationDate.toISOString()}>
      {article.data.publicationDate.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" })}
    </time>
    <span>·</span>
    <span>{article.data.readingTime} min read</span>
  </div>

  <h1 class="article-title text-3xl leading-tight font-medium tracking-tighter text-pretty sm:text-4xl">
    {article.data.title}
  </h1>
</header>

<style>
  .article-meta {
    color: var(--color--foreground--50);
  }
  .article-title {
    color: var(--color--foreground--100);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
</style>
