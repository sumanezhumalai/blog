{
  "compatibility_date": "2026-04-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "NEWSLETTER_TOKENS",
      "id": "replace-in-production",
      "preview_id": "replace-in-preview",
    },
  ],
}
